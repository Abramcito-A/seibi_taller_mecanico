APP_NAME=SEIBI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En producción debe ser la URL pública con HTTPS; los enlaces del correo usan este valor.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En desarrollo se usa "log": el mensaje se escribe en storage/logs y NO llega al cliente.
# Envío real con Brevo SMTP (ver pasos en config/seibi.php): MAIL_MAILER=smtp, puerto 587 con STARTTLS.
# MAIL_USERNAME y MAIL_PASSWORD (clave SMTP de Brevo, no una API key) solo van en el .env del servidor.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=20
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Direcciones provisionales reservadas (.invalid): el sistema bloquea el envío real mientras se usen.
MAIL_FROM_ADDRESS="notificaciones@dominio-pendiente.invalid"
MAIL_FROM_NAME="SEIBI"

# Identidad del taller y enlaces privados de cotización.
SEIBI_WORKSHOP_NAME="SEIBI | Taller Mecánico"
SEIBI_QUOTATION_LINK_TTL_DAYS=7
SEIBI_TRACKING_LINK_DAYS_AFTER_CLOSE=30
SEIBI_MAIL_REPLY_TO="contacto@dominio-pendiente.invalid"
# Cambiar a true solo cuando Brevo marque SPF y DKIM del dominio como verificados.
SEIBI_MAIL_DOMAIN_VERIFIED=false

# Modo de prueba local (solo APP_ENV=local): envío SMTP real con un remitente verificado individualmente en Brevo,
# sin dominio autenticado. Requiere MAIL_MAILER=smtp, APP_URL público con HTTPS (p. ej. un túnel temporal) y
# credenciales SMTP. Solo se entrega a SEIBI_TEST_RECIPIENT; cualquier otro destinatario se rechaza.
SEIBI_ALLOW_UNVERIFIED_SENDER_FOR_LOCAL=false
SEIBI_TEST_RECIPIENT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SERPAPI_API_KEY=
